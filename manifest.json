{
  "manifest_version": 3,
  "name": "Gloss — 网页沉浸学英语与翻译",
  "version": "0.5.3",
  "description": "Gloss — 网页沉浸式英语学习与双语翻译助手：智能行内替换、词元标注、微批双语翻译、输入框译英与 SM-2 主动回忆训练。",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Gloss",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/utils.js",
        "src/shared/storage.js",
        "src/content/matcher.js",
        "src/content/dom-utils.js",
        "src/content/engine-replace.js",
        "src/content/engine-annotate.js",
        "src/content/engine-translate.js",
        "src/content/input-enhance.js",
        "src/content/shadow-ui.js",
        "src/content/bootstrap.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/data/wordbank.json",
        "src/data/wordbank-meta.json"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "切换当前页双语对比翻译 / 显隐译文"
    },
    "cycle-mode": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "切换当前页学习模式（替换 / 标注 / 翻译 / 关闭）"
    },
    "translate-input": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "将当前输入框中的中文即时翻译为英文"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
