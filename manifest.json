{
  "manifest_version": 3,
  "name": "IFLL — Immersive English Learning",
  "version": "0.5.1",
  "description": "Immersive English learning & bilingual web translation — smart inline swap, lemmatized annotation, micro-batch bilingual translation, input translation, and SM-2 active recall.",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "IFLL",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/utils.js",
        "src/shared/storage.js",
        "src/content/matcher.js",
        "src/content/dom-utils.js",
        "src/content/engine-replace.js",
        "src/content/engine-annotate.js",
        "src/content/engine-translate.js",
        "src/content/input-enhance.js",
        "src/content/shadow-ui.js",
        "src/content/bootstrap.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/data/wordbank.json",
        "src/data/wordbank-meta.json"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": [
      "src/shared/constants.js",
      "src/shared/utils.js",
      "src/shared/storage.js",
      "src/background/cache-db.js",
      "src/background/ai-client.js",
      "src/background/batch-runner.js",
      "src/background/background.js"
    ]
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "切换当前页双语对比翻译 / 显隐译文"
    },
    "cycle-mode": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "切换当前页学习模式（替换 / 标注 / 翻译 / 关闭）"
    },
    "translate-input": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "将当前输入框中的中文即时翻译为英文"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ifll@wto.li",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
